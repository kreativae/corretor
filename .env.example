# PostgreSQL (Drizzle)
DATABASE_URL=postgresql://user:password@host:5432/imobmanager

# 0 = autenticação obrigatória (produção) · 1 = acesso liberado (dev/ajustes)
AUTH_OPEN=0

# Bearer token esperado em POST /api/cron/google-sync
CRON_SECRET=troque-por-um-segredo-longo

# Google OAuth 2.0 (Cloud Console) — preencher ou cadastrar no painel admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: base pública usada em URLs (sitemap/robots)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
