# Domínio público da VM. Sem domínio próprio, use o IP com sslip.io:
# IP 129.146.10.20  →  DOMAIN=129-146-10-20.sslip.io
DOMAIN=129-146-10-20.sslip.io

# Senha longa e aleatória — é a "Chave da API" no CRM (Configurações › WhatsApp)
AUTHENTICATION_API_KEY=troque-por-uma-senha-longa

# Banco Postgres da Evolution (ex.: banco novo "evolution" no Neon, plano grátis)
DATABASE_CONNECTION_URI=postgresql://usuario:senha@host/evolution?sslmode=require
